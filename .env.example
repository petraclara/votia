DATABASE_URL=

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Daraja credentials (never expose to the client)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=

# Optional Daraja overrides
# DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# DARAJA_PARTY_B=

# Local sandbox notes:
# - Keep NEXT_PUBLIC_APP_URL and NEXTAUTH_URL on http://localhost:3000
# - Safaricom cannot call localhost. Set DARAJA_CALLBACK_URL to a public HTTPS
#   tunnel or Vercel URL, e.g. https://xxxx.trycloudflare.com/api/webhooks/daraja
# - Fulfilment still works via STK Query polling if the callback is delayed
# - Public Safaricom sandbox Lipa Na M-Pesa Online test values (not secrets):
#   DARAJA_SHORTCODE=174379
#   DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Cloudinary (required on Vercel / production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=votia

PLATFORM_FEE_PERCENT="10"
DEFAULT_PAYOUT_FEE_KES="0"

