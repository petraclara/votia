DATABASE_URL="postgresql://votia:votia@localhost:5434/votia?schema=public"

NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Your app Consumer Key / Secret from the Daraja portal (never commit real values)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Portal often shows Passkey/Short Code as N/A in sandbox.
# Use Safaricom's public Lipa Na M-Pesa Online sandbox test values locally,
# then replace with your Go-Live shortcode + passkey in production.
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_SHORTCODE=174379
DARAJA_ENV=sandbox

# Optional: CustomerPayBillOnline (default) or CustomerBuyGoodsOnline
# DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional override when PartyB differs from shortcode
# DARAJA_PARTY_B=

# REQUIRED for local sandbox: Safaricom rejects http://localhost callbacks.
# Keep NEXT_PUBLIC_APP_URL=http://localhost:3000 for the app itself.
# Point this at a public HTTPS tunnel or your Vercel deployment webhook:
#   npx cloudflared tunnel --url http://localhost:3000
# then set:
# DARAJA_CALLBACK_URL=https://xxxx.trycloudflare.com/api/webhooks/daraja
# Fulfilment still works via STK Query polling even if the callback is delayed.
DARAJA_CALLBACK_URL=

# Persistent image uploads via Cloudinary (required on Vercel / production)
# From https://console.cloudinary.com/ — never commit real secrets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix (default: votia)
# CLOUDINARY_FOLDER=votia
# Local development can omit Cloudinary and write to public/uploads (not durable on Vercel).

PLATFORM_FEE_PERCENT="10"
DEFAULT_PAYOUT_FEE_KES="0"

NEXT_PUBLIC_WHATSAPP="254700000000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@votia.co.ke"
NEXT_PUBLIC_CONTACT_PHONE="+254 700 000 000"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/votia"
NEXT_PUBLIC_FACEBOOK="https://facebook.com/votia"
NEXT_PUBLIC_X="https://x.com/votia"
